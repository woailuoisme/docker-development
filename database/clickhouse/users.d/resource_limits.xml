<clickhouse>
    <profiles>
        <default>
            <!-- ============================================================================== -->
            <!-- ClickHouse 默认用户查询配额、Spill-to-Disk 与异步写入调优 -->
            <!-- ============================================================================== -->

            <!-- 1. 计算资源与并发线程 (针对 2~4 核 CPU 调优) -->
            <max_threads>2</max_threads>
            <max_block_size>8192</max_block_size>
            <queue_max_wait_ms>1000</queue_max_wait_ms>
            <max_execution_time>600</max_execution_time>

            <!-- 2. 格式解析流式处理: 禁用大缓冲并行解析，降低高并发导入峰值内存 -->
            <input_format_parallel_parsing>0</input_format_parallel_parsing>
            <output_format_parallel_formatting>0</output_format_parallel_formatting>

            <!-- 3. 单查询内存硬上限: 800MB (838860800 字节) -->
            <!-- 超过此限制立即终止查询，保障整体服务与容器不被单个异常查询拖垮 -->
            <max_memory_usage>838860800</max_memory_usage>

            <!-- 4. Spill-to-Disk (溢出落盘): 超过 500MB 强制外排，保障复杂聚合平稳完成 -->
            <!-- 500MB = 524288000 字节 -->
            <max_bytes_before_external_group_by>524288000</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>524288000</max_bytes_before_external_sort>
            <max_bytes_ratio_before_external_sort>0.5</max_bytes_ratio_before_external_sort>

            <!-- 5. 异步写入 (Async Insert): 开启自然背压与防丢批量刷盘机制 -->
            <async_insert>1</async_insert>
            <!-- wait_for_async_insert=1: 服务端等待批次刷盘落盘后才向客户端应答，保证数据零丢失且天然限制内存堆积 -->
            <wait_for_async_insert>1</wait_for_async_insert>
            <!-- 异步批次数据上限 10MB (10485760 字节) -->
            <async_insert_max_data_size>10485760</async_insert_max_data_size>
            <!-- 异步批次最大等待超时 200ms -->
            <async_insert_busy_timeout_ms>200</async_insert_busy_timeout_ms>
        </default>
    </profiles>
</clickhouse>

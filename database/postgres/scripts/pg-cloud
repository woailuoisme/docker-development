#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="pg-cloud"

ENDPOINT_ARGS=()
if [ -n "${BARMAN_CLOUD_S3_ENDPOINT:-}" ]; then
  ENDPOINT_ARGS+=(--endpoint-url "${BARMAN_CLOUD_S3_ENDPOINT}")
fi

SERVER_NAME="${BARMAN_CLOUD_SERVER_NAME:-postgres18}"
BUCKET="${BARMAN_CLOUD_BUCKET:-postgres-backups}"
DESTINATION_URL="s3://${BUCKET}/${SERVER_NAME}"
RETENTION_POLICY="${BARMAN_CLOUD_RETENTION:-REDUNDANCY 7}"

get_compression_args() {
  case "${BARMAN_CLOUD_COMPRESSION:-gzip}" in
    snappy) echo "--snappy" ;;
    none)   echo "" ;;
    *)      echo "--gzip" ;;
  esac
}

usage() {
  cat <<EOF
PostgreSQL 云原生备份与恢复 CLI (${SCRIPT_NAME})

用法:
  ${SCRIPT_NAME} <command> [arguments...]

命令:
  status                          查看备份与归档健康状态 (主库 LSN、S3 全备与 WAL 连续性)
  backup                          执行全量物理基础备份并应用保留策略清理
  check                           校验 S3 WAL 归档连续性 (断层排查)
  list                            列出 S3 备份仓库中的物理备份清单
  prune [--retention <policy>]    清理超出保留策略的历史备份与孤立 WAL (默认: ${RETENTION_POLICY})
  restore [backup_id|latest] <target_dir> [--force] [--target-time "<timestamp>"]
                                  从 S3 还原基础备份，可配置 PITR 回放参数
  archive <wal_path>              [archive_command 钩子] 归档 WAL 至 S3
  restore-wal <wal_name> <dest>   [restore_command 钩子] 从 S3 拉取 WAL 回放
EOF
}

cmd_archive() {
  local wal_path="${1:-}"
  if [ -z "${wal_path}" ]; then
    echo "错误: 未提供 WAL 文件路径" >&2
    exit 1
  fi

  # 未启用云归档或未配桶时跳过 (exit 0)，防止开发环境堆积 WAL 撑爆磁盘
  if [ "${BARMAN_CLOUD_ENABLED:-false}" != "true" ] || [ -z "${BARMAN_CLOUD_BUCKET:-}" ]; then
    exit 0
  fi

  local comp_arg
  comp_arg="$(get_compression_args)"

  local exec_args=(
    barman-cloud-wal-archive
    --cloud-provider aws-s3
    "${ENDPOINT_ARGS[@]}"
  )
  [ -n "${comp_arg}" ] && exec_args+=("${comp_arg}")
  exec_args+=("${DESTINATION_URL}" "${wal_path}")

  exec "${exec_args[@]}"
}

cmd_restore_wal() {
  local wal_name="${1:-}"
  local wal_dest="${2:-}"

  if [ -z "${wal_name}" ] || [ -z "${wal_dest}" ]; then
    echo "错误: 未提供 WAL 文件名 (%f) 或目标路径 (%p)" >&2
    exit 1
  fi

  exec barman-cloud-wal-restore \
    --cloud-provider aws-s3 \
    "${ENDPOINT_ARGS[@]}" \
    "${DESTINATION_URL}" \
    "${wal_name}" \
    "${wal_dest}"
}

cmd_backup() {
  echo "==> 执行全量物理备份 (${DESTINATION_URL})..."
  barman-cloud-backup \
    --cloud-provider aws-s3 \
    "${ENDPOINT_ARGS[@]}" \
    "${DESTINATION_URL}"

  echo "==> 应用保留策略 (${RETENTION_POLICY})..."
  barman-cloud-backup-delete \
    --cloud-provider aws-s3 \
    "${ENDPOINT_ARGS[@]}" \
    --retention-policy "${RETENTION_POLICY}" \
    "${DESTINATION_URL}"
}

cmd_list() {
  barman-cloud-backup-list \
    --cloud-provider aws-s3 \
    "${ENDPOINT_ARGS[@]}" \
    "${DESTINATION_URL}"
}

cmd_check() {
  echo "==> 校验 WAL 归档连续性 (${DESTINATION_URL})..."
  barman-cloud-check-wal-archive \
    --cloud-provider aws-s3 \
    "${ENDPOINT_ARGS[@]}" \
    "${DESTINATION_URL}"
}

cmd_status() {
  echo "--- 存储配置 ---"
  echo "端点:      ${BARMAN_CLOUD_S3_ENDPOINT:-默认 AWS S3}"
  echo "目标仓库:  ${DESTINATION_URL}"
  echo "保留策略:  ${RETENTION_POLICY}"
  echo "云归档:    ${BARMAN_CLOUD_ENABLED:-false}"
  echo ""

  echo "--- 实例状态 ---"
  if pg_isready -h localhost -p 5432 -q 2>/dev/null; then
    local db_user="${POSTGRES_USER:-postgres}"
    local db_name="${POSTGRES_DB:-postgres}"
    local lsn_info arch_info
    lsn_info="$(psql -U "${db_user}" -d "${db_name}" -t -A -c "SELECT pg_current_wal_lsn() || ' (Recovery: ' || pg_is_in_recovery() || ')'" 2>/dev/null || echo "无法获取")"
    arch_info="$(psql -U "${db_user}" -d "${db_name}" -t -A -c "SELECT 'Archived: ' || archived_count || ', Failed: ' || failed_count || ', Last: ' || COALESCE(last_archived_wal, 'none') FROM pg_stat_archiver" 2>/dev/null || echo "无法获取")"
    echo "数据库:    运行中 (Online)"
    echo "当前 LSN:  ${lsn_info}"
    echo "归档统计:  ${arch_info}"
  else
    echo "数据库:    未运行 (Offline)"
  fi
  echo ""

  echo "--- 远端全备 ---"
  barman-cloud-backup-list \
    --cloud-provider aws-s3 \
    "${ENDPOINT_ARGS[@]}" \
    "${DESTINATION_URL}" || echo "（获取备份清单失败）"
  echo ""

  echo "--- WAL 连续性 ---"
  barman-cloud-check-wal-archive \
    --cloud-provider aws-s3 \
    "${ENDPOINT_ARGS[@]}" \
    "${DESTINATION_URL}" || echo "（WAL 连续性异常）"
}

cmd_prune() {
  local policy="${RETENTION_POLICY}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --retention)
        policy="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  echo "==> 清理历史归档 [${policy}]..."
  barman-cloud-backup-delete \
    --cloud-provider aws-s3 \
    "${ENDPOINT_ARGS[@]}" \
    --retention-policy "${policy}" \
    "${DESTINATION_URL}"
}

cmd_restore() {
  local force=false
  local target_time=""
  local args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)
        force=true
        shift
        ;;
      --target-time)
        target_time="$2"
        shift 2
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  local backup_id="latest"
  local target_dir=""

  if [ "${#args[@]}" -eq 1 ]; then
    target_dir="${args[0]}"
  elif [ "${#args[@]}" -ge 2 ]; then
    backup_id="${args[0]}"
    target_dir="${args[1]}"
  else
    echo "错误: 请指定恢复目标数据目录" >&2
    echo "用法: ${SCRIPT_NAME} restore [backup_id|latest] <target_dir> [--force] [--target-time 'timestamp']" >&2
    exit 1
  fi

  # 活跃实例保护：禁止覆盖运行中主库目录
  local active_pgdata="${PGDATA:-/var/lib/postgresql/data}"
  if [ -f "${target_dir}/postmaster.pid" ] || { [ "${target_dir}" = "${active_pgdata}" ] && pg_isready -h localhost -p 5432 -q 2>/dev/null; }; then
    echo "错误: 检测到活跃 PostgreSQL 实例，禁止向运行中的数据目录恢复" >&2
    exit 1
  fi

  # 非空目录保护
  if [ -d "${target_dir}" ] && [ "$(ls -A "${target_dir}" 2>/dev/null)" ]; then
    if [ "${force}" != "true" ]; then
      echo "错误: 目标目录 [${target_dir}] 非空，如需覆盖请指定 --force" >&2
      exit 1
    fi
  fi

  mkdir -p "${target_dir}"

  echo "==> 还原基础备份 [${backup_id}] -> ${target_dir}..."
  barman-cloud-restore \
    --cloud-provider aws-s3 \
    "${ENDPOINT_ARGS[@]}" \
    "${DESTINATION_URL}" \
    "${backup_id}" \
    "${target_dir}"

  if [ -n "${target_time}" ]; then
    echo "==> 配置 PITR 恢复点: ${target_time}..."
    cat >> "${target_dir}/postgresql.auto.conf" <<EOF

# PITR recovery configuration
restore_command = '/usr/local/bin/pg-cloud restore-wal %f %p'
recovery_target_time = '${target_time}'
recovery_target_action = 'promote'
EOF
    touch "${target_dir}/recovery.signal"
  fi
}

COMMAND="${1:-}"
shift || true

case "${COMMAND}" in
  archive)     cmd_archive "$@" ;;
  restore-wal) cmd_restore_wal "$@" ;;
  backup)      cmd_backup "$@" ;;
  status)      cmd_status "$@" ;;
  list)        cmd_list "$@" ;;
  check)       cmd_check "$@" ;;
  prune)       cmd_prune "$@" ;;
  restore)     cmd_restore "$@" ;;
  help|--help|-h|"") usage ;;
  *)
    echo "错误: 未知命令 '${COMMAND}'" >&2
    usage >&2
    exit 1
    ;;
esac

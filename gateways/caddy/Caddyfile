	# —— snippet 在此处无法展开（已实测：File to import not found）。
	# 这些文件放在 layer4/ 而**不能**放 templates/：templates/* 会被顶层 glob 导入，
	# 其中的 layer4 块会被当作站点地址解析，而 `proxy` 不是 HTTP 指令 → 解析失败。
	# 各端点的说明见 layer4/ 目录下对应文件的头部注释
	# layer4 {
	# 	# 数据库入口：单端口（5432）承载 postgres 直连与 pgbouncer 池化两个上游，按 SNI 分流
	# 	import layer4/postgres.conf
	# 	import layer4/valkey.conf
	# }
}


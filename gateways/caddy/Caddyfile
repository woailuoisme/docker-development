# 显式声明通配符主机名，让 Caddy 申请并复用 *.{$SITE_ADDRESS} 证书。
# 未匹配到具体服务的子域名直接中止连接，避免暴露默认响应。
*.{$SITE_ADDRESS}, http://localhost {
	handle /health {
		respond "OK" 200
	}
	handle {
		abort
	}
}

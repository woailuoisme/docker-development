APP_NAME=Lunchbox
APP_ENV=production
APP_KEY=base64:mockkeymockkeymockkeymockkeymockkeymock=
APP_DEBUG=false
APP_URL=http://api.example.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lunchbox
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=
REDIS_PORT=6379

OCTANE_SERVER=roadrunner

APP_ENV=fpm
TIMEZONE=Asia/Shanghai
NETWORK_EXTERNAL=false

CHANGE_SOURCE=true
# 宿主机应用代码根目录与容器挂载配置
APP_CODE_PATH=/var/www
APP_CODE_PATH_CONTAINER=/var/www
APP_CODE_CONTAINER_FLAG=:cached
# 容器内 Laravel 应用项目目录
APP_PATH=/var/www/lunchbox

# 数据与配置持久化路径
CONFIG_PATH=/var/docker/development/
DATA_PATH=/var/docker/development/data/
LOG_PATH=/var/docker/development/logs/

# 宿主机运行权限 (默认 1000/1000 或 macOS 501/20)
PUID=1000
PGID=1000

### DOMAIN & DNS ##########################################
# 根域名 / 基础域名 (用于各子服务子域名前缀及 ACME 证书签发)
SITE_ADDRESS=example.com

# Cloudflare DNS API 凭证 (Caddy / Traefik / Lego 等网关 DNS-01 验证)
CF_API_TOKEN=

# 阿里云 DNS API 凭证 (Lego 等网关 DNS-01 验证)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 腾讯云 DNS API 凭证 (若使用 tencentcloud)
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=

### LEGO (ACME) ############################################
# goacme/lego 证书管理员联系邮箱
LEGO_EMAIL=admin@example.com

### TRAEFIK GATEWAY #######################################
# Traefik v3 边缘网关端口与服务配置
# TRAEFIK_PORT=80
# TRAEFIK_SSL_PORT=443
# AUTHELIA_HOST=authelia:9091

### CROWDSEC WAF & IDS #####################################
# CrowdSec 自动化入侵防御与网关 Bouncer 认证密钥
# 默认已预设本地开发密钥；若开启生产部署，请修改为高强度随机字符
# CROWDSEC_BOUNCER_KEY=crowdsec-traefik-bouncer-dev-secret-key-32ch
# CROWDSEC_BOUNCER_KEY_CADDY=crowdsec-caddy-bouncer-dev-secret-key-32ch

### CLOUDFLARE TUNNEL #####################################
# 在 Cloudflare Zero Trust Dashboard 创建 Tunnel 后复制 token
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

### NGINX #################################################
NGINX_HOST_HTTP_PORT=80
NGINX_HOST_HTTPS_PORT=443
NGINX_HOST_WSS_PORT=8080

### PHP & LARAVEL RUNTIME #################################
APP_PORT=8000

### REDIS / VALKEY ##########################################

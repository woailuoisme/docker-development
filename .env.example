APP_ENV=fpm
TIMEZONE=Asia/Shanghai
NETWORK_EXTERNAL=false

CHANGE_SOURCE=true
# 宿主机应用代码根目录与容器挂载配置
APP_CODE_PATH=/var/www
APP_CODE_PATH_CONTAINER=/var/www
APP_CODE_CONTAINER_FLAG=:cached
# 容器内 Laravel 应用项目目录
APP_PATH=/var/www/lunchbox

# 数据与配置持久化路径
CONFIG_PATH=/var/docker/development/
DATA_PATH=/var/docker/development/data/
LOG_PATH=/var/docker/development/logs/

# 宿主机运行权限 (默认 1000/1000 或 macOS 501/20)
PUID=1000
PGID=1000

### DOMAIN & DNS ##########################################
# 根域名 / 基础域名 (用于各子服务子域名前缀及 ACME 证书签发)
SITE_ADDRESS=example.com

# Cloudflare DNS API 凭证 (Caddy / Traefik / Lego 等网关 DNS-01 验证)
CF_API_TOKEN=

# 阿里云 DNS API 凭证 (Lego 等网关 DNS-01 验证)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 腾讯云 DNS API 凭证 (若使用 tencentcloud)
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=

### LEGO (ACME) ############################################
# goacme/lego 证书管理员联系邮箱
LEGO_EMAIL=admin@example.com

### TRAEFIK GATEWAY #######################################
# Traefik v3 边缘网关端口与服务配置
# TRAEFIK_PORT=80
# TRAEFIK_SSL_PORT=443
# AUTHELIA_HOST=authelia:9091

### HAPROXY GATEWAY #######################################
# HAProxy 3.4 边缘反向代理与负载均衡
# HAPROXY_PORT=80
# HAPROXY_SSL_PORT=443
# HAPROXY_STATS_PORT=8404
# HAPROXY_STATS_USER=admin
# HAPROXY_STATS_PASSWORD=admin

### CROWDSEC WAF & IDS #####################################
# CrowdSec 自动化入侵防御与网关 Bouncer 认证密钥
# 默认已预设本地开发密钥；若开启生产部署，请修改为高强度随机字符
# CROWDSEC_BOUNCER_KEY=crowdsec-traefik-bouncer-dev-secret-key-32ch
# CROWDSEC_BOUNCER_KEY_CADDY=crowdsec-caddy-bouncer-dev-secret-key-32ch
# CROWDSEC_LAPI_HOST=crowdsec:8080
# CROWDSEC_APPSEC_HOST=crowdsec:7422

### TRIVY SECURITY SCANNER ################################
# Aqua Security Trivy 容器镜像、IaC 与依赖漏洞扫描引擎
TRIVY_PORT=4954
# TRIVY_AUTH_TOKEN=
# TRIVY_DEBUG=false

### CLOUDFLARE TUNNEL #####################################
# 在 Cloudflare Zero Trust Dashboard 创建 Tunnel 后复制 token
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

### NGINX #################################################
NGINX_HOST_HTTP_PORT=80
NGINX_HOST_HTTPS_PORT=443
NGINX_HOST_WSS_PORT=8080

### PHP & LARAVEL RUNTIME #################################
APP_PORT=8000

### REDIS / VALKEY ##########################################
# 不可为空：database/valkey/docker-entrypoint.sh 只在非空时才注入 --requirepass
# 为空时 valkey 不带口令启动，而 valkey.conf 的 protected-mode 会拒绝所有非回环来源，
# 表现为「连不上」而非「敞开的缓存」—— 同样不可接受，请务必设置
REDIS_PASSWORD=

### MYSQL #################################################
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=lunchbox
MYSQL_USER=appuser
MYSQL_PASSWORD=
MYSQL_PORT=43306

### POSTGRES ##############################################
# 已不再用于发布宿主端口：postgres-18 不再映射宿主机端口，宿主 5432 由 gateways/caddy
# 的 layer4 入口占用（pg.<域名> / pg-pooler.<域名>，强制 TLS，客户端可省略端口）
# POSTGRES_PORT=5432
POSTGRES_DB=lunchbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

### PGBOUNCER #############################################
# auth_user (pgbouncer_auth) 的引导密码，PgBouncer 启动时写入 userlist.txt
# 必须与 postgres-18 服务使用同一个值（见 database/pgbouncer/README.md）
PGBOUNCER_AUTH_PASSWORD=

### MINIO #################################################
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
MINIO_PORT=9526
MINIO_PORT_UI=9527

### ALIYUN OSS ############################################
OSS_ENDPOINT=https://oss-cn-heyuan.aliyuncs.com
OSS_BUCKET=lunchbox-dev

### MONGODB ###############################################
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASSWORD=
MONGODB_PORT=27017

### CLICKHOUSE ############################################
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_TCP_PORT=9000

### MEILISEARCH ###########################################
MEILI_PORT=7700
# 同时用于 vmagent 抓取 /metrics（bearer_token_file）
MEILI_MASTER_KEY=

### GARAGE (vmagent 抓取鉴权) #############################
# Garage Admin API /metrics 需要 bearer token；由 `just vm-scrape-secrets` 写入
# ${DATA_PATH}victoria-agent/secrets/garage_metrics_token，仓库内不存明文
GARAGE_METRICS_TOKEN=

### TYPESENSE #############################################
TYPESENSE_PORT=8108
# 必需变量：Typesense 缺少 API key 会拒绝启动；启用前先生成一个（openssl rand -hex 24）
TYPESENSE_API_KEY=

### NATS ##################################################
NATS_USER=app
# 必需变量：docker-compose.yml 刻意不提供兜底默认值，缺失会导致 nats 启动失败（见 messaging/nats/README.md）
NATS_PASSWORD=

### RABBITMQ ##############################################
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=app-host

### REDPANDA ##############################################
# REDPANDA_KAFKA_PORT=19092
# REDPANDA_SCHEMA_REGISTRY_PORT=18081
# REDPANDA_PANDAPROXY_PORT=18082
# REDPANDA_ADMIN_PORT=9644
# REDPANDA_CONSOLE_PORT=18080

### CENTRIFUGO ############################################
CENTRIFUGO_API_KEY=++WnV+LKf1vzZIfzMNqjbK/eb/DDqgnX42izczRWRqU=
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=ZB/KWEscGOEhQchAWAhsHiV4qvZjigM3jdSsC1W1YpY=
CENTRIFUGO_ADMIN_PASSWORD=admin123
CENTRIFUGO_ADMIN_SECRET=++WnV+LKf1vzZIfzMNqjbK/eb/DDqgnX42izczRWRqU=

### GOTIFY ################################################
GOTIFY_PORT=8380
GOTIFY_DEFAULTUSER_NAME=admin
GOTIFY_DEFAULTUSER_PASS=y6KW7wiPE4nWvl
GOTIFY_APP_TOKEN=AS_sgKeMkMvevEM

### GRAFANA ###############################################
GRAFANA_PORT=13000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

### VICTORIAMETRICS ECOSYSTEM #############################
VICTORIA_METRICS_PORT=8428
VICTORIA_LOGS_PORT=9428
VMAGENT_PORT=8429
VMALERT_PORT=8880
VICTORIA_TRACES_PORT=10428
VICTORIA_TRACES_OTLP_GRPC_PORT=4317
# Jaeger v2 官方镜像：链路库 + UI 一体（OTLP/gRPC 4317 不发布到宿主机，避免与上面冲突）
JAEGER_VERSION=2.21.0
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318

### MQTT BROKER ###########################################
MQTT_USERNAME=admin
MQTT_PASSWORD=admin123!
MQTT_USERS=
MQTT_PORT=1883
MQTT_TLS_PORT=8883

### TELEGRAF ##############################################
TELEGRAF_PORT=9080

### AUTHELIA ##############################################
AUTHELIA_JWT_SECRET=sUdz4hhhKPMhplagMREEsRtiRZ9yF1ldr3e5iJv8AQQqXUAe35gEmY8ycS4ffSwm
AUTHELIA_SESSION_SECRET=481F2EN0L2RQJHT882OSM481F2EN0L2RQJHT882OSM
AUTHELIA_STORAGE_ENCRYPTION_KEY=481F2EN0L2RQJHT882OSM481F2EN0L2RQJHT882OSM
RESEND_API_KEY=

### ZITADEL ###############################################
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters

### BESZEL ################################################
BESZEL_PORT=8090
BESZEL_AGENT_PORT=45876
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=

### INFISICAL #############################################
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=

### OPENOBSERVE ###########################################
# 全栈可观测平台（observability/open-observe）。真实凭证只写本地 .env（已被 .gitignore 忽略）
OPENOBSERVE_ROOT_EMAIL=
OPENOBSERVE_ROOT_PASSWORD=
# OTel Collector 摄取头："Basic " + base64("账号:密码")
O2_AUTH=

### WHAT'S UP DOCKER (WUD) ################################
# 认证变量与管理员口令等敏感项不放这里，统一由 docker-tools/wud/docker-compose.yml
# 引用的 .env.wud 提供（v9 起认证强制，缺失管理员账号会启动失败）
WUD_VERSION=9.1.0
WUD_PORT=3200

### ASYNQMON ##############################################
ASYNQMON_PORT=8080

### ADMINER ###############################################
ADMINER_PORT=18080

### GITEA ##################################################
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=222

### WOODPECKER CI #########################################
WOODPECKER_PORT=8000
WOODPECKER_AGENT_SECRET=7f8c9b3d2e1a4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a
